{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "Warranty.Api",
    "Audience": "Warranty.Client",
    "AccessTokenMinutes": 30,
    "RefreshTokenDays": 7
  },
  "Upload": {
    "RootPath": "App_Data/uploads",
    "MaxFileSizeBytes": 10485760,
    "AllowedContentTypes": [
      "image/jpeg",
      "image/png",
      "image/webp",
      "image/gif",
      "application/pdf"
    ],
    "AllowedExtensions": [ ".jpg", ".jpeg", ".png", ".webp", ".gif", ".pdf" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=localhost\\SQLEXPRESS;Database=Warranty;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;"
  }
}
